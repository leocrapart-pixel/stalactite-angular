{
  "name": "stalactite-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Stalactite growth simulation \u2014 Angular port of the Elm app",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "tsx tests/physics.test.ts && tsx tests/render.test.ts",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "deploy": "ng build && wrangler deploy",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.0"
  }
}
